<%- include('../partials/header', { title: 'Associations' }) %>
    <div class="mb-8 flex items-end justify-between">
        <div>
            <p class="text-sm font-bold uppercase tracking-widest text-orange">Partners</p>
            <h1 class="text-4xl font-black text-plum">Associations</h1>
        </div><a href="/associations/create" class="rounded-xl bg-orange px-5 py-3 font-bold text-white">+ Create
            Association</a>
    </div>
    <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
        <% associations.forEach(association=> { %><article class="rounded-2xl bg-white p-6 shadow-soft">
                <div class="mb-4 flex justify-between">
                    <div class="grid h-12 w-12 place-items-center rounded-xl bg-sand/50 font-black text-plum">A</div>
                    <div class="flex gap-2"><a href="/associations/<%= association.id %>/edit"
                            class="text-sm font-bold text-plum">Edit</a>
                        <form action="/associations/<%= association.id %>/delete" method="POST"><button
                                class="text-sm font-bold text-orange">Delete</button></form>
                    </div>
                </div>
                <h2 class="text-xl font-black text-plum">
                    <%= association.name %>
                </h2>
                <p class="mt-3 text-sm text-plum/60">
                    <%= association.email || 'No email' %>
                </p>
                <p class="mt-1 text-sm text-plum/60">
                    <%= association.phone || 'No phone' %>
                </p>
            </article>
            <% }) %>
    </div><%- include('../partials/footer') %>