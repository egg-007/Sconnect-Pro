<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Edit Facility - SportConnect Pro</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <h1>Edit Facility</h1>

    <form
        action="/facilities/<%= facility.id %>/update"
        method="POST"
    >

        <div>
            <label>Name</label>

            <input
                type="text"
                name="name"
                value="<%= facility.name %>"
                required
            >
        </div>

        <div>
            <label>Type</label>

            <input
                type="text"
                name="type"
                value="<%= facility.type %>"
                required
            >
        </div>

        <div>
            <label>Address</label>

            <input
                type="text"
                name="address"
                value="<%= facility.address || '' %>"
            >
        </div>

        <div>
            <label>ERP Capacity</label>

            <input
                type="number"
                name="erp_capacity"
                min="1"
                value="<%= facility.erp_capacity %>"
                required
            >
        </div>

        <div>
            <label>

                <input
                    type="checkbox"
                    name="is_divisible"
                    value="true"
                    <%= facility.is_divisible ? "checked" : "" %>
                >

                Divisible

            </label>
        </div>

        <button type="submit">
            Update Facility
        </button>

    </form>

    <a href="/facilities">
        Back
    </a>

</body>

</html>