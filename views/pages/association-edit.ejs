<%- include('../partials/header', { title: 'Edit Association' }) %>
    <div class="mx-auto max-w-2xl">
        <h1 class="mb-8 text-4xl font-black text-plum">Edit Association</h1>
        <form action="/associations/<%= association.id %>/update" method="POST"
            class="space-y-5 rounded-2xl bg-white p-7 shadow-soft">
            <div><label class="mb-2 block text-sm font-bold text-plum">Name</label><input name="name"
                    value="<%= association.name %>" required class="w-full rounded-xl border border-plum/10 px-4 py-3">
            </div>
            <div><label class="mb-2 block text-sm font-bold text-plum">Email</label><input type="email" name="email"
                    value="<%= association.email || '' %>" class="w-full rounded-xl border border-plum/10 px-4 py-3">
            </div>
            <div><label class="mb-2 block text-sm font-bold text-plum">Phone</label><input name="phone"
                    value="<%= association.phone || '' %>" class="w-full rounded-xl border border-plum/10 px-4 py-3">
            </div>
            <div class="flex gap-3"><button class="rounded-xl bg-orange px-5 py-3 font-bold text-white">Save
                    Changes</button><a href="/associations"
                    class="rounded-xl border border-plum/10 px-5 py-3 font-bold text-plum">Cancel</a></div>
        </form>
    </div><%- include('../partials/footer') %>