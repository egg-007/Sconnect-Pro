<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Create Association</title>

    <link
        rel="stylesheet"
        href="/css/style.css"
    >
</head>

<body>

    <h1>Create Association</h1>

    <form
        action="/associations"
        method="POST"
    >

        <div>

            <label>Name</label>

            <input
                type="text"
                name="name"
                required
            >

        </div>

        <div>

            <label>Email</label>

            <input
                type="email"
                name="email"
            >

        </div>

        <div>

            <label>Phone</label>

            <input
                type="text"
                name="phone"
            >

        </div>

        <button type="submit">
            Create Association
        </button>

    </form>

    <a href="/associations">
        Back
    </a>

</body>

</html>