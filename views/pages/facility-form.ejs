<%- include('../partials/header', { title: 'Create Facility' }) %>
    <div class="mx-auto max-w-2xl">
        <h1 class="mb-8 text-4xl font-black text-plum">Create Facility</h1>
        <form action="/facilities" method="POST" class="space-y-5 rounded-2xl bg-white p-7 shadow-soft">
            <div><label class="mb-2 block text-sm font-bold text-plum">Name</label><input name="name" required
                    class="w-full rounded-xl border border-plum/10 px-4 py-3"></div>
            <div class="grid gap-5 md:grid-cols-2">
                <div><label class="mb-2 block text-sm font-bold text-plum">Type</label><input name="type" required
                        class="w-full rounded-xl border border-plum/10 px-4 py-3"></div>
                <div><label class="mb-2 block text-sm font-bold text-plum">ERP Capacity</label><input type="number"
                        min="1" name="erp_capacity" required class="w-full rounded-xl border border-plum/10 px-4 py-3">
                </div>
            </div>
            <div><label class="mb-2 block text-sm font-bold text-plum">Address</label><input name="address"
                    class="w-full rounded-xl border border-plum/10 px-4 py-3"></div><label
                class="flex items-center gap-3 rounded-xl bg-sand/25 p-4"><input type="checkbox" name="is_divisible"
                    value="true" class="accent-orange"><span class="font-semibold text-plum">Divisible into
                    sub-zones</span></label>
            <div class="flex gap-3"><button class="rounded-xl bg-orange px-5 py-3 font-bold text-white">Create
                    Facility</button><a href="/facilities"
                    class="rounded-xl border border-plum/10 px-5 py-3 font-bold text-plum">Cancel</a></div>
        </form>
    </div><%- include('../partials/footer') %>