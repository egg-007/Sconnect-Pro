<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Create Facility - SportConnect Pro</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <h1>Create Facility</h1>

    <form action="/facilities" method="POST">

        <div>
            <label>Name</label>

            <input
                type="text"
                name="name"
                required
            >
        </div>

        <div>
            <label>Type</label>

            <input
                type="text"
                name="type"
                required
            >
        </div>

        <div>
            <label>Address</label>

            <input
                type="text"
                name="address"
            >
        </div>

        <div>
            <label>ERP Capacity</label>

            <input
                type="number"
                name="erp_capacity"
                min="1"
                required
            >
        </div>

        <div>
            <label>
                <input
                    type="checkbox"
                    name="is_divisible"
                    value="true"
                >

                Divisible
            </label>
        </div>

        <button type="submit">
            Create Facility
        </button>

    </form>

    <a href="/facilities">
        Back to facilities
    </a>

</body>

</html>