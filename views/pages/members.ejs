<%- include('../partials/header', { title: 'Members' }) %>
    <div class="mb-8 flex items-end justify-between">
        <div>
            <p class="text-sm font-bold uppercase tracking-widest text-orange">Community</p>
            <h1 class="text-4xl font-black text-plum">Members</h1>
        </div><a href="/members/create" class="rounded-xl bg-orange px-5 py-3 font-bold text-white">+ Create Member</a>
    </div>
    <div class="overflow-hidden rounded-2xl bg-white shadow-soft">
        <div class="overflow-x-auto">
            <table class="min-w-full text-sm">
                <thead class="bg-plum text-left text-white">
                    <tr>
                        <th class="px-5 py-4">Member</th>
                        <th class="px-5 py-4">Family</th>
                        <th class="px-5 py-4">Birth date</th>
                        <th class="px-5 py-4">Email</th>
                        <th class="px-5 py-4">Medical</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-plum/5">
                    <% members.forEach(member=> { %><tr class="hover:bg-sand/20">
                            <td class="px-5 py-4 font-bold text-plum">
                                <%= member.first_name %>
                                    <%= member.last_name %>
                            </td>
                            <td class="px-5 py-4">
                                <%= member.family_name %>
                            </td>
                            <td class="px-5 py-4">
                                <%= member.birth_date %>
                            </td>
                            <td class="px-5 py-4">
                                <%= member.email || '-' %>
                            </td>
                            <td class="px-5 py-4"><span
                                    class="rounded-full px-3 py-1 text-xs font-bold <%= member.medical_status === 'compliant' ? 'bg-green-100 text-green-700' : 'bg-orange/10 text-orange' %>">
                                    <%= member.medical_status %>
                                </span></td>
                        </tr>
                        <% }) %>
                </tbody>
            </table>
        </div>
    </div><%- include('../partials/footer') %>