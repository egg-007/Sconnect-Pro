<%- include('../partials/header', { title: 'Activities' }) %>
    <div class="mb-8 flex items-end justify-between">
        <div>
            <p class="text-sm font-bold uppercase tracking-widest text-orange">Scheduling</p>
            <h1 class="text-4xl font-black text-plum">Activities</h1>
        </div><a href="/activities/create" class="rounded-xl bg-orange px-5 py-3 font-bold text-white">+ Create
            Activity</a>
    </div>
    <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
        <% activities.forEach(activity=> { %><article class="rounded-2xl bg-white p-6 shadow-soft">
                <div class="mb-4 flex items-start justify-between">
                    <div>
                        <h2 class="text-xl font-black text-plum">
                            <%= activity.name %>
                        </h2>
                        <p class="mt-1 text-sm text-plum/50">
                            <%= activity.association_name %>
                        </p>
                    </div><span class="rounded-full bg-orange/10 px-3 py-1 text-xs font-bold text-orange">
                        <%= activity.status %>
                    </span>
                </div>
                <div class="space-y-2 text-sm text-plum/70">
                    <p><strong>Facility:</strong>
                        <%= activity.facility_name %>
                    </p>
                    <p><strong>Season:</strong>
                        <%= activity.season %>
                    </p>
                    <p><strong>Schedule:</strong>
                        <%= activity.day_of_week %>, <%= activity.start_time %>–<%= activity.end_time %>
                    </p>
                    <p><strong>Capacity:</strong>
                        <%= activity.max_capacity %>
                    </p>
                    <p><strong>Price:</strong> €<%= activity.base_price %>
                    </p>
                </div>
            </article>
            <% }) %>
    </div><%- include('../partials/footer') %>