<%- include('../partials/header', { title: 'Create Activity' }) %>
    <div class="mx-auto max-w-4xl">
        <h1 class="mb-8 text-4xl font-black text-plum">Create Activity</h1>
        <form action="/activities" method="POST" class="grid gap-5 rounded-2xl bg-white p-7 shadow-soft md:grid-cols-2">
            <div class="md:col-span-2"><label class="mb-2 block text-sm font-bold text-plum">Activity Name</label><input
                    name="name" required class="w-full rounded-xl border border-plum/10 px-4 py-3"></div>
            <div><label class="mb-2 block text-sm font-bold text-plum">Association</label><select name="association_id"
                    required class="w-full rounded-xl border border-plum/10 px-4 py-3">
                    <% associations.forEach(a=> { %><option value="<%= a.id %>">
                            <%= a.name %>
                        </option>
                        <% }) %>
                </select></div>
            <div><label class="mb-2 block text-sm font-bold text-plum">Facility</label><select name="facility_id"
                    required class="w-full rounded-xl border border-plum/10 px-4 py-3">
                    <% facilities.forEach(f=> { %><option value="<%= f.id %>">
                            <%= f.name %> · ERP <%= f.erp_capacity %>
                        </option>
                        <% }) %>
                </select></div>
            <div><label class="mb-2 block text-sm font-bold text-plum">Season</label><input name="season"
                    placeholder="2026-2027" required class="w-full rounded-xl border border-plum/10 px-4 py-3"></div>
            <div><label class="mb-2 block text-sm font-bold text-plum">Day</label><select name="day_of_week"
                    class="w-full rounded-xl border border-plum/10 px-4 py-3">
                    <% ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'].forEach(day=> { %>
                        <option value="<%= day %>">
                            <%= day %>
                        </option>
                        <% }) %>
                </select></div>
            <div><label class="mb-2 block text-sm font-bold text-plum">Start Time</label><input type="time"
                    name="start_time" required class="w-full rounded-xl border border-plum/10 px-4 py-3"></div>
            <div><label class="mb-2 block text-sm font-bold text-plum">End Time</label><input type="time"
                    name="end_time" required class="w-full rounded-xl border border-plum/10 px-4 py-3"></div>
            <div><label class="mb-2 block text-sm font-bold text-plum">Sub-zone</label><input name="sub_zone"
                    class="w-full rounded-xl border border-plum/10 px-4 py-3"></div>
            <div><label class="mb-2 block text-sm font-bold text-plum">Maximum Capacity</label><input type="number"
                    min="1" name="max_capacity" required class="w-full rounded-xl border border-plum/10 px-4 py-3">
            </div>
            <div><label class="mb-2 block text-sm font-bold text-plum">Base Price</label><input type="number" min="0"
                    step="0.01" name="base_price" required class="w-full rounded-xl border border-plum/10 px-4 py-3">
            </div>
            <div><label class="mb-2 block text-sm font-bold text-plum">Age Category</label><input name="age_category"
                    class="w-full rounded-xl border border-plum/10 px-4 py-3"></div>
            <div class="md:col-span-2 flex gap-6 rounded-xl bg-sand/25 p-4"><label
                    class="flex items-center gap-2 font-semibold text-plum"><input type="checkbox" name="is_all_public"
                        value="true" class="accent-orange">All public</label><label
                    class="flex items-center gap-2 font-semibold text-plum"><input type="checkbox" name="is_risk_sport"
                        value="true" class="accent-orange">Risk sport</label></div>
            <div class="md:col-span-2 flex gap-3"><button
                    class="rounded-xl bg-orange px-5 py-3 font-bold text-white">Create Activity</button><a
                    href="/activities" class="rounded-xl border border-plum/10 px-5 py-3 font-bold text-plum">Cancel</a>
            </div>
        </form>
    </div><%- include('../partials/footer') %>