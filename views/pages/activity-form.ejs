<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Create Activity - SportConnect Pro</title>

    <link
        rel="stylesheet"
        href="/css/style.css"
    >
</head>

<body>

    <h1>Create Activity</h1>

    <form
        action="/activities"
        method="POST"
    >

        <div>
            <label>Name</label>

            <input
                type="text"
                name="name"
                required
            >
        </div>


        <div>
            <label>Association</label>

            <select
                name="association_id"
                required
            >

                <% associations.forEach(association => { %>

                    <option value="<%= association.id %>">
                        <%= association.name %>
                    </option>

                <% }) %>

            </select>
        </div>


        <div>
            <label>Facility</label>

            <select
                name="facility_id"
                required
            >

                <% facilities.forEach(facility => { %>

                    <option value="<%= facility.id %>">
                        <%= facility.name %>
                        -
                        ERP <%= facility.erp_capacity %>
                    </option>

                <% }) %>

            </select>
        </div>


        <div>
            <label>Season</label>

            <input
                type="text"
                name="season"
                placeholder="2026-2027"
                required
            >
        </div>


        <div>
            <label>Day</label>

            <select
                name="day_of_week"
                required
            >

                <option value="Monday">Monday</option>
                <option value="Tuesday">Tuesday</option>
                <option value="Wednesday">Wednesday</option>
                <option value="Thursday">Thursday</option>
                <option value="Friday">Friday</option>
                <option value="Saturday">Saturday</option>
                <option value="Sunday">Sunday</option>

            </select>
        </div>


        <div>
            <label>Start Time</label>

            <input
                type="time"
                name="start_time"
                required
            >
        </div>


        <div>
            <label>End Time</label>

            <input
                type="time"
                name="end_time"
                required
            >
        </div>


        <div>
            <label>Sub-zone</label>

            <input
                type="text"
                name="sub_zone"
                placeholder="Example: A"
            >
        </div>


        <div>
            <label>Maximum Capacity</label>

            <input
                type="number"
                name="max_capacity"
                min="1"
                required
            >
        </div>


        <div>
            <label>Base Price</label>

            <input
                type="number"
                name="base_price"
                min="0"
                step="0.01"
                required
            >
        </div>


        <div>
            <label>Age Category</label>

            <input
                type="text"
                name="age_category"
                placeholder="U18, Senior..."
            >
        </div>


        <div>

            <label>

                <input
                    type="checkbox"
                    name="is_all_public"
                    value="true"
                >

                All public

            </label>

        </div>


        <div>

            <label>

                <input
                    type="checkbox"
                    name="is_risk_sport"
                    value="true"
                >

                Risk sport

            </label>

        </div>


        <button type="submit">
            Create Activity
        </button>

    </form>

    <a href="/activities">
        Back
    </a>

</body>

</html>